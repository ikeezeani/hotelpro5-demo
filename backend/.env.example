# =========================================
# HotelPro 5.0 — Backend Environment Config
# Generated/edited by the installation wizard (npm run install-wizard)
# =========================================

# --- Server ---
NODE_ENV=production
PORT=3000
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:5172

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hotelpro5
DB_POOL_LIMIT=10

# --- Auth ---
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# --- Hotel / Currency defaults (also stored in DB after wizard) ---
DEFAULT_CURRENCY_CODE=USD
DEFAULT_CURRENCY_SYMBOL=$

# --- Payment Gateways (fill in whichever you enable) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=

# --- Email (for confirmations / invoices) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="HotelPro 5.0 <no-reply@yourhotel.com>"

# Cron schedule for the daily low-stock digest email (default: 7:00 AM server time)
LOW_STOCK_DIGEST_CRON=0 7 * * *

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
