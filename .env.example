# =========================================================
# HotelPro 5.0 — Docker Compose environment
# Copy this file to ".env" in the project root before running
# `docker compose up`. Docker Compose reads ".env" automatically.
# =========================================================

# --- MySQL (used by the "db" service and passed to "backend") ---
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=hotelpro5
MYSQL_USER=hotelpro
MYSQL_PASSWORD=change_this_password

# --- Backend ---
# Generate your own with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# --- Ports exposed on the host machine ---
APP_HTTP_PORT=5172
API_PORT=3000

# --- Used by the backend for CORS; set to your public frontend URL in production ---
CLIENT_URL=http://localhost:5172

# --- Payment gateways (optional — leave blank to disable) ---
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# --- Email (optional — leave blank to disable booking confirmations, receipts, and the
#     daily low-stock digest; the app runs fine without SMTP configured) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="HotelPro 5.0 <no-reply@yourhotel.com>"
LOW_STOCK_DIGEST_CRON=0 7 * * *
